# Databricks workspace connection
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# Unity Catalog
UC_CATALOG=databricks_medallion
UC_BRONZE_SCHEMA=bronze
UC_SILVER_SCHEMA=silver
UC_GOLD_SCHEMA=gold

# Path (Unity Catalog Volume or DBFS) where raw source CSVs are landed
SOURCE_VOLUME_PATH=/Volumes/databricks_medallion/bronze/landing